# Postgres Configuration
POSTGRES_DB=oqdb
POSTGRES_USER=oquser
POSTGRES_PASSWORD=oqpword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Security Variables
SECRET_KEY=secret-key-here # `openssl rand -hex 32`
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ollama variables
OLLAMA_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:1.5b

# Doc data
DOC_LOCATION=./docs
MAX_FILES_UPLOAD=8